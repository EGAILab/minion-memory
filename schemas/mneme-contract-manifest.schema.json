{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minion-memory.local/schemas/mneme-contract-manifest.schema.json",
  "title": "Minion-Memory contract manifest (traceability, not semantic authority)",
  "type": "object",
  "required": ["manifest_version", "contract", "rows"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": {"const": 1},
    "contract": {
      "type": "object",
      "required": ["bundle_id", "bundle_manifest", "spec_root", "status_registry"],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {"type": "string", "minLength": 1},
        "bundle_manifest": {"type": "string", "minLength": 1},
        "spec_root": {"type": "string", "minLength": 1},
        "status_registry": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/row"}
    }
  },
  "$defs": {
    "requirement_id": {"type": "string", "pattern": "^[A-Z]{2,5}-[0-9]{3}$"},
    "row": {
      "type": "object",
      "required": ["id", "title", "family", "profile", "layer", "sources", "spec", "source_status",
                   "disposition", "scenarios", "python", "rust", "evidence", "findings"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/requirement_id"},
        "title": {"type": "string", "minLength": 1},
        "family": {"type": "string", "pattern": "^[A-Z]{2,5}$"},
        "profile": {"enum": ["core", "learning", "agent"]},
        "layer": {"type": "string", "pattern": "^([0-9]{2}|cross-cutting)$"},
        "sources": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^\\[[A-Z0-9]+ §[^\\]]+\\]$"}
        },
        "spec": {"type": "string", "pattern": "^spec/[a-z0-9/_-]+\\.md#[a-z]+-[0-9]{3}$"},
        "source_status": {"enum": ["FROZEN", "PROVISIONAL", "RESEARCH_CANDIDATE", "MVP_ONLY",
                                   "SCHEMA_RESERVATION", "NOT_IN_MVP", "NORMATIVE", "GUARDRAIL"]},
        "disposition": {"enum": ["adopted", "reserved", "deferred", "not_in_mvp", "informative", "retired"]},
        "deferred_trigger": {"type": "string", "minLength": 1},
        "superseded_by": {"type": "array", "items": {"$ref": "#/$defs/requirement_id"}},
        "scenarios": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "python": {"$ref": "#/$defs/location"},
        "rust": {"$ref": "#/$defs/location"},
        "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "findings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$"}}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "deferred"}}}, "then": {"required": ["deferred_trigger"]}},
        {"if": {"properties": {"disposition": {"const": "retired"}}}, "then": {"required": ["superseded_by"]}}
      ]
    },
    "location": {
      "type": "object",
      "required": ["location"],
      "additionalProperties": false,
      "properties": {
        "location": {"type": ["string", "null"]},
        "note": {"type": "string"}
      }
    }
  }
}
