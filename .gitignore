# OWN-001: generated files stay in the parent project's .tmp directories.
# Safety nets also cover tools run without the project environment.

# Local worktrees, scratch files and caches
/review-worktrees/
/worktrees/
.tmp/
.cache/
.uv-cache/
/artifacts/

